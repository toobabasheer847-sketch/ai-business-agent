NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ai_business_agent
REDIS_URL=

GOOGLE_GENAI_API_KEY=
GEMINI_MODEL= 

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/google/auth/callback

JWT_SECRET=
JWT_EXPIRES_IN=7d

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_TWIML_APP_SID=

# ---------------------------------------------------------------------------
# SMTP — optional Gmail SMTP transport (separate from Gmail API OAuth flow)
#
# Use an App Password for SMTP_PASS (not your normal Gmail password).
# Generate one at: https://myaccount.google.com/apppasswords
#
# This transport auto-activates when SMTP_HOST / SMTP_PORT / SMTP_USER /
# SMTP_PASS / SMTP_FROM are all set. Leave them blank to disable.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=your_gmail_address@gmail.com
