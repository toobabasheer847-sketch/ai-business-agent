NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ai_business_agent
REDIS_URL=

GOOGLE_GENAI_API_KEY=
GEMINI_MODEL= 

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/google/auth/callback

JWT_SECRET=
JWT_EXPIRES_IN=7d

# Local directory for original knowledge documents (tenant/knowledgeBase/document scoped).
KNOWLEDGE_STORAGE_DIR=./storage/knowledge


CORS_ORIGINS=http://localhost:5173

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_TWIML_APP_SID=

# Public backend base URL Twilio can reach (no trailing slash).
# Local: set to your ngrok/tunnel HTTPS URL. Do not invent a placeholder.
# Builds:
#   ${TWILIO_WEBHOOK_BASE_URL}/api/webhooks/twilio/call/inbound
#   ${TWILIO_WEBHOOK_BASE_URL}/api/webhooks/twilio/sms/inbound
#   ${TWILIO_WEBHOOK_BASE_URL}/api/webhooks/twilio/call/status
TWILIO_WEBHOOK_BASE_URL=

GMAIL_SMTP_USERNAME=
GMAIL_SMTP_PASSWORD=
GMAIL_SMTP_FROM_NAME=AI Business Agent

# ---------------------------------------------------------------------------
# SMTP — optional Gmail SMTP transport (separate from Gmail API OAuth flow)
#
# Use an App Password for SMTP_PASS (not your normal Gmail password).
# Generate one at: https://myaccount.google.com/apppasswords
#
# This transport auto-activates when SMTP_HOST / SMTP_PORT / SMTP_USER /
# SMTP_PASS / SMTP_FROM are all set. Leave them blank to disable.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=your_gmail_address@gmail.com
