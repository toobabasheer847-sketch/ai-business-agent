NODE_ENV=development
PORT=3000

# PostgreSQL (required). Local default matches the common docker/postgres port.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_business_agent

# Redis (recommended for queued document ingestion). Leave blank to fall back
# to in-process ingestion after a queue enqueue failure.
REDIS_URL=redis://127.0.0.1:6379

GOOGLE_GENAI_API_KEY=
# Gemini model used for chat/RAG synthesis (e.g. gemini-2.0-flash).
GEMINI_MODEL=gemini-2.0-flash

# RAG retrieval tuning (optional — defaults shown).
# RAG_MIN_SIMILARITY: minimum cosine similarity to return a chunk candidate (default 0.2).
# RAG_ANSWER_MIN_SIMILARITY: minimum similarity before the LLM may answer from KB (default 0.4).
RAG_MIN_SIMILARITY=0.2
RAG_ANSWER_MIN_SIMILARITY=0.4

# Max previous messages loaded into Assistant chat context (default 20, max 50).
AI_CHAT_HISTORY_LIMIT=20

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the Nest global prefix (`/api`) and Gmail controller path.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/auth/callback

# Required in every environment, including local. Production refuses to start without it.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Local directory for original knowledge documents (tenant/knowledgeBase/document scoped).
KNOWLEDGE_STORAGE_DIR=./storage/knowledge

CORS_ORIGINS=http://localhost:5173

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_TWIML_APP_SID=

# Public backend base URL Twilio can reach (no trailing slash).
# Local: set to your ngrok/tunnel HTTPS URL. Do not invent a placeholder.
# Builds:
#   ${TWILIO_WEBHOOK_BASE_URL}/api/webhooks/twilio/call/inbound
#   ${TWILIO_WEBHOOK_BASE_URL}/api/webhooks/twilio/sms/inbound
#   ${TWILIO_WEBHOOK_BASE_URL}/api/webhooks/twilio/call/status
TWILIO_WEBHOOK_BASE_URL=

GMAIL_SMTP_USERNAME=
GMAIL_SMTP_PASSWORD=
GMAIL_SMTP_FROM_NAME=AI Business Agent

# ---------------------------------------------------------------------------
# SMTP — optional Gmail SMTP transport (separate from Gmail API OAuth flow)
#
# Use an App Password for SMTP_PASS (not your normal Gmail password).
# Generate one at: https://myaccount.google.com/apppasswords
#
# This transport auto-activates when SMTP_HOST / SMTP_PORT / SMTP_USER /
# SMTP_PASS / SMTP_FROM are all set. Leave them blank to disable.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
